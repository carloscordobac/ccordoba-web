---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "ccordoba.es — el laboratorio de Carlos Córdoba Camacho",
  description = "Laboratorio personal de Carlos Córdoba Camacho: proyectos con datos abiertos de transporte público y prototipado con IA.",
  image,
  type,
  noindex = false,
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Carlos Córdoba Camacho",
  url: "https://ccordoba.es",
  sameAs: ["https://linkedin.com/in/carloscordobacamacho"],
  jobTitle: "Jefe de proyecto",
  worksFor: {
    "@type": "Organization",
    name: "Renfe Viajeros",
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* TODO: pegar el código de verificación de Google Search Console y descomentar */}
    {/* <meta name="google-site-verification" content="TU_CODIGO_AQUI" /> */}

    {/* TODO: pegar el código de verificación de Bing Webmaster Tools y descomentar */}
    {/* <meta name="msvalidate.01" content="TU_CODIGO_AQUI" /> */}

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body id="top" class="bg-paper text-ink font-body antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
