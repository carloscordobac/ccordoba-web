---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;

const thumbs = await Promise.all(
  images.map((img) =>
    getImage({ src: img, width: 960, height: 540, format: "webp", quality: 75 })
  )
);
const full = await Promise.all(
  images.map((img) => getImage({ src: img, format: "webp", quality: 85 }))
);
---

<div class="group/carousel relative aspect-video overflow-hidden bg-via/40" data-carousel>
  <div class="flex h-full w-full" data-track>
    {
      thumbs.map((thumb, i) => (
        <button
          type="button"
          class="h-full w-full flex-none cursor-zoom-in appearance-none border-0 bg-transparent p-0"
          data-lightbox-src={full[i].src}
          data-lightbox-alt={`${alt} — captura ${i + 1} de ${images.length}`}
          aria-label={`Ampliar captura ${i + 1} de ${images.length}`}
        >
          <img
            src={thumb.src}
            width={thumb.attributes.width}
            height={thumb.attributes.height}
            alt={`${alt} — captura ${i + 1} de ${images.length}`}
            class="h-full w-full object-cover"
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Captura anterior"
          class="absolute left-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border-0 bg-black/80 text-lg leading-none text-white shadow-md transition-opacity hover:bg-black opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Captura siguiente"
          class="absolute right-2 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border-0 bg-black/80 text-lg leading-none text-white shadow-md transition-opacity hover:bg-black opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100"
        >
          ›
        </button>
        <div class="absolute bottom-2.5 left-1/2 flex -translate-x-1/2 gap-1.5" data-dots>
          {images.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              data-active={i === 0}
              aria-label={`Ir a la captura ${i + 1}`}
              class="h-1.5 w-1.5 rounded-full border-0 bg-white/60 p-0 transition-all data-[active=true]:w-3.5 data-[active=true]:bg-white"
            />
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  function setupCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
      if (carousel.dataset.initialized) return;
      carousel.dataset.initialized = "true";

      const track = carousel.querySelector<HTMLElement>("[data-track]");
      const slides = Array.from(track?.children ?? []) as HTMLElement[];
      const prevBtn = carousel.querySelector<HTMLElement>("[data-prev]");
      const nextBtn = carousel.querySelector<HTMLElement>("[data-next]");
      const dots = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-dot]")
      );
      let index = 0;

      function update() {
        if (track) track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => {
          dot.dataset.active = String(i === index);
        });
      }

      function go(delta: number) {
        index = (index + delta + slides.length) % slides.length;
        update();
      }

      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        go(-1);
      });
      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        go(1);
      });
      dots.forEach((dot, i) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          index = i;
          update();
        });
      });
    });
  }

  setupCarousels();
  document.addEventListener("astro:page-load", setupCarousels);
</script>
