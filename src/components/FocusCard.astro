---
interface Props {
  icon: any;
  title: string;
  description: string;
}

const { icon: Icon, title, description } = Astro.props;
---

<div class="bg-paper px-8 py-6">
  <div class="flex items-center gap-2.5">
    <Icon size={19} class="shrink-0 text-senal" />
    <h3 class="font-display text-[17px] font-semibold">{title}</h3>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-[#54575F]">{description}</p>
</div>
