---
interface Props {
  slug: string;
  categoria: string;
  numeroTexto: string;
  nombre: string;
  fabricante: string;
  imagenSrc: string;
  acuarelaSrc: string;
  marco: string;
  colorCategoria: string;
}

const {
  slug,
  categoria,
  numeroTexto,
  nombre,
  fabricante,
  imagenSrc,
  acuarelaSrc,
  marco,
  colorCategoria,
} = Astro.props;
---

<div
  class="carta-mini"
  tabindex="0"
  role="button"
  aria-label={`Ver detalle de ${nombre}`}
  data-slug={slug}
>
  <img class="capa foto foto-real" src={imagenSrc} alt="" loading="lazy" decoding="async" />
  <img
    class="capa foto foto-acuarela"
    src={acuarelaSrc}
    alt=""
    loading="lazy"
    decoding="async"
  />

  <div class="cabecera">
    <div class="banda" style={`background:${colorCategoria}`} aria-hidden="true" />
    <p class="categoria">{categoria}</p>
  </div>

  <div class="capa marco" set:html={marco} />
  <p class="numero">{numeroTexto}</p>

  <div class="pie">
    <div class="banda" style={`background:${colorCategoria}`} aria-hidden="true" />
    <div class="info">
      <p class="nombre">{nombre}</p>
      <p class="fabricante">{fabricante}</p>
    </div>
  </div>
</div>

<style>
  .carta-mini {
    position: relative;
    aspect-ratio: 558 / 779.25;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: #0c0c10;
    outline-offset: 4px;
    font-family: "Sora", sans-serif;
  }
  .carta-mini:focus-visible {
    outline: 2px solid #9fc9c4;
  }

  .capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .foto {
    /* Sangra 2px más allá del contenedor para que no se asome un filo de
       1-2px del fondo de la imagen (blanco, sobre todo en las acuarelas)
       por redondeo de subpíxel entre el <img> y el overflow:hidden de la
       carta. El border-radius del contenedor sigue recortando todo. */
    position: absolute;
    inset: -2px;
    width: calc(100% + 4px);
    height: calc(100% + 4px);
    object-fit: cover;
    z-index: 1;
  }
  .foto-real {
    filter: contrast(1.08) saturate(0.88) sepia(0.08) hue-rotate(-4deg) brightness(0.96);
  }
  .foto-acuarela {
    display: none;
  }
  :global(body.modo-acuarela) .foto-real {
    display: none;
  }
  :global(body.modo-acuarela) .foto-acuarela {
    display: block;
  }

  /*
    Orden de capas (foto → bandas de color → marco → texto): .cabecera y
    .pie no llevan z-index propio para no crear un contexto de apilamiento
    que atrape a sus hijos — así .banda (z-index:2) queda siempre por
    debajo del marco (z-index:3) y el texto (z-index:4) siempre por
    encima, aunque banda y texto compartan la misma celda de grid.

    La banda ocupa el 100% del ancho y llega justo al borde de la carta
    (.cabecera/.pie sin padding/margin propios); su altura se ajusta sola
    al contenido real porque comparte celda de grid con el texto: la fila
    se dimensiona por el texto (único con altura intrínseca) y la banda,
    con height:100%, hereda esa misma altura.
  */
  .cabecera,
  .pie {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
    display: grid;
    pointer-events: none;
  }
  .cabecera {
    top: 0;
  }
  .pie {
    bottom: 0;
  }

  .cabecera .banda,
  .pie .banda {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .marco {
    z-index: 3;
    pointer-events: none;
  }
  .marco :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .categoria {
    grid-area: 1 / 1;
    z-index: 4;
    margin: 0;
    /* Texto 3px más abajo (padding-top) y banda 3px menos alta en total
       (top+bottom suma 3px menos que antes): solo en la miniatura. */
    padding: 23px 8% 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #fff;
  }

  .numero {
    position: absolute;
    top: 5%;
    right: 6%;
    z-index: 4;
    margin: 0;
    font-weight: 700;
    font-size: 11px;
    color: #fff;
  }

  .info {
    grid-area: 1 / 1;
    z-index: 4;
    /* Abajo, más aire que arriba: la banda llega hasta el borde de la
       carta (bottom:0), pero el texto tiene que quedarse antes de la
       placa "ccordoba.es" que dibuja el marco en esa misma zona. */
    padding: 10px 7% 8%;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .nombre {
    margin: 0;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    color: #fff;
  }
  .fabricante {
    margin: 0;
    font-weight: 500;
    font-size: 8.5px;
    color: #cfc9db;
  }
</style>
