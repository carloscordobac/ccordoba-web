---
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/90 p-6 backdrop-blur-sm"
  aria-hidden="true"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Cerrar"
    class="absolute right-5 top-5 z-10 flex h-10 w-10 items-center justify-center rounded-full border-0 bg-ink/80 text-white shadow-md transition hover:bg-ink"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18" /><path d="m6 6 12 12" />
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-prev"
    aria-label="Imagen anterior"
    class="absolute left-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-0 bg-paper/10 text-2xl leading-none text-paper transition hover:bg-paper/20 sm:left-5"
  >
    ‹
  </button>
  <button
    type="button"
    id="lightbox-next"
    aria-label="Imagen siguiente"
    class="absolute right-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-0 bg-paper/10 text-2xl leading-none text-paper transition hover:bg-paper/20 sm:right-5"
  >
    ›
  </button>

  <img id="lightbox-image" src="" alt="" class="max-h-full max-w-full select-none rounded-md object-contain" />

  <div
    id="lightbox-counter"
    class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 rounded-full bg-ink/80 px-3 py-1 font-mono text-xs text-white shadow-md"
  ></div>
</div>

<script>
  function initLightbox() {
    const root = document.getElementById("lightbox");
    const image = document.getElementById("lightbox-image") as HTMLImageElement | null;
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const counter = document.getElementById("lightbox-counter");
    if (!root || !image || root.dataset.initialized) return;
    root.dataset.initialized = "true";

    let group: HTMLElement[] = [];
    let index = 0;

    function isOpen() {
      return root?.getAttribute("aria-hidden") === "false";
    }

    function render() {
      if (!image) return;
      const current = group[index];
      image.src = current?.dataset.lightboxSrc ?? "";
      image.alt = current?.dataset.lightboxAlt ?? "";

      const multi = group.length > 1;
      prevBtn?.classList.toggle("hidden", !multi);
      nextBtn?.classList.toggle("hidden", !multi);
      if (counter) {
        counter.classList.toggle("hidden", !multi);
        counter.textContent = multi ? `${index + 1} / ${group.length}` : "";
      }
    }

    function show(i: number) {
      if (!group.length) return;
      index = (i + group.length) % group.length;
      render();
    }

    function open(trigger: HTMLElement) {
      const scope = trigger.closest("[data-carousel]") ?? document;
      group = Array.from(scope.querySelectorAll<HTMLElement>("[data-lightbox-src]"));
      const startIndex = group.indexOf(trigger);
      show(startIndex === -1 ? 0 : startIndex);

      root?.classList.remove("hidden");
      root?.classList.add("flex");
      root?.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function close() {
      root?.classList.add("hidden");
      root?.classList.remove("flex");
      root?.setAttribute("aria-hidden", "true");
      if (image) image.src = "";
      document.body.style.overflow = "";
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const trigger = target.closest<HTMLElement>("[data-lightbox-src]");
      if (trigger) {
        open(trigger);
        return;
      }

      if (!isOpen()) return;
      const onControl = target.closest(
        "#lightbox-image, #lightbox-close, #lightbox-prev, #lightbox-next"
      );
      if (!onControl) close();
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(index - 1);
    });
    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      show(index + 1);
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
  }

  initLightbox();
  document.addEventListener("astro:page-load", initLightbox);
</script>
