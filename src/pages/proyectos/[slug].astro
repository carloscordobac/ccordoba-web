---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos");
  return proyectos
    // "incendios-tiempo-real" ya tiene su propia página con el visor en vivo
    // (/incendios-tiempo-real/); "identidad-marca" tiene su propia página
    // editorial (proyectos/identidad-marca.astro), con una estructura muy
    // distinta a la genérica (Objetivo/Datos/Arquitectura) de este layout.
    // Ninguna de las dos necesita esta página genérica.
    .filter(
      (proyecto) => !["incendios-tiempo-real", "identidad-marca"].includes(proyecto.id),
    )
    .map((proyecto) => ({
      params: { slug: proyecto.id },
      props: { proyecto },
    }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<ProjectLayout
  title={proyecto.data.title}
  description={proyecto.data.description}
  tags={proyecto.data.tags}
  link={proyecto.data.link}
  video={proyecto.data.video}
  objetivo={proyecto.data.objetivo}
  datos={proyecto.data.datos}
  arquitectura={proyecto.data.arquitectura}
  galeria={proyecto.data.galeria}
  cuerpo_titulo={proyecto.data.cuerpo_titulo}
  estado_actual={proyecto.data.estado_actual}
>
  <Content />
</ProjectLayout>
