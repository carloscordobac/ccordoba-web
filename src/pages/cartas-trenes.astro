---
import fs from "node:fs";
import path from "node:path";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TrainCardThumbnail from "../components/TrainCardThumbnail.astro";
import TrainCardExpanded from "../components/TrainCardExpanded.astro";
import trenesData from "../content/proyectos/cartas-trenes/trenes.json";

interface Tren {
  slug: string;
  numero: number;
  categoria: string;
  categoria_slug: string;
  nombre: string;
  fabricante: string;
  velocidad_texto: string;
  potencia_texto: string;
  masa_texto: string | null;
  unidades_construidas: number;
  ecologico: number;
  historico: number;
  hito: string;
  nuevo?: boolean;
}

const trenes = trenesData as Tren[];

// Imágenes reales de cada tren (por slug). Puede haber .jpg o .png.
const imagenesModules = import.meta.glob<ImageMetadata>(
  "../content/proyectos/cartas-trenes/imagenes/*.{jpg,jpeg,png}",
  { eager: true, import: "default" },
);

// Marco SVG único para todas las categorías (el color ya no va incrustado
// en el SVG: se aplica por encima con CSS, ver COLOR_CATEGORIA).
const marcosModules = import.meta.glob<string>(
  "../content/proyectos/cartas-trenes/marcos/*.svg",
  { eager: true, query: "?raw", import: "default" },
);
const marcoUniversal = findAsset(marcosModules, /marco-solo\.svg$/);

// Mismo color por categoría que llevaba incrustado cada marco SVG antes de
// unificarlos en uno solo: se extrajo de la "ola" de cada uno para no
// perder la asociación categoria → color ya establecida en el proyecto.
const COLOR_CATEGORIA: Record<string, string> = {
  "alta-velocidad": "#1652a8",
  "ancho-metrico": "#6e2c2c",
  "ancho-variable": "#2e6e8e",
  avant: "#3e8fb0",
  cercanias: "#2e8b57",
  "larga-distancia": "#5b4b8a",
  "media-distancia": "#2e8e8e",
  mercancias: "#8a4b2f",
  "trenes-turisticos": "#9a6b2c",
};

// Opacidad fija de la capa de color de categoría detrás de los bloques de
// texto (cabecera / pie). rgba() en vez de opacity para no atenuar también
// el texto que se pinta encima en el mismo elemento.
const OPACIDAD_BANDA = 0.9;

function hexToRgba(hex: string, alpha: number): string {
  const limpio = hex.replace("#", "");
  const r = parseInt(limpio.slice(0, 2), 16);
  const g = parseInt(limpio.slice(2, 4), 16);
  const b = parseInt(limpio.slice(4, 6), 16);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
};

function findAsset<T>(modules: Record<string, T>, filename: RegExp): T | undefined {
  const match = Object.entries(modules).find(([path]) => filename.test(path));
  return match?.[1];
}

const defaultImage = findAsset(imagenesModules, /\/default\.(jpe?g|png)$/i);

// Imágenes de acuarela (por slug): viven en public/, sin pasar por el
// pipeline de astro:assets, así que comprobamos su existencia a mano en
// build. Si un tren no tiene la suya, y tampoco existe un default de
// acuarela todavía, usamos su foto real como sustituto temporal (mejor
// que una imagen rota) hasta que se suba el lote completo.
const ACUARELA_DIR = path.resolve("./public/proyectos/cartas-trenes/imagenes-acuarela");
const ACUARELA_URL_BASE = "/proyectos/cartas-trenes/imagenes-acuarela";

const EXTENSIONES_ACUARELA = ["webp", "jpg", "png"];

function resolverAcuarela(slug: string, fallbackFoto: string): string {
  for (const ext of EXTENSIONES_ACUARELA) {
    if (fs.existsSync(path.join(ACUARELA_DIR, `${slug}.${ext}`))) {
      return `${ACUARELA_URL_BASE}/${slug}.${ext}`;
    }
  }
  for (const ext of EXTENSIONES_ACUARELA) {
    if (fs.existsSync(path.join(ACUARELA_DIR, `default.${ext}`))) {
      return `${ACUARELA_URL_BASE}/default.${ext}`;
    }
  }
  return fallbackFoto;
}

// El SVG exportado de Canva trae width/height fijos (p. ej. 744x1039) en la
// etiqueta raíz. Como está incrustado inline, los quitamos y dejamos que el
// viewBox + preserveAspectRatio gobiernen el escalado al 100% del
// contenedor, sea cual sea su tamaño real (miniatura o carta ampliada).
function stripRootSvgSize(svg: string): string {
  return svg.replace(/^<svg\b[^>]*>/, (openTag) =>
    openTag.replace(/\s(width|height)="[^"]*"/g, ""),
  );
}

// Cada marco SVG comparte los mismos id (clipPath, etc.) porque viene del
// mismo generador. Como ahora CADA tren aparece incrustado dos veces a la
// vez en la página (su miniatura en la rejilla + su carta ampliada,
// precargada y oculta), no basta con un namespace por tren: hace falta uno
// distinto por instancia, o los dos <svg> del mismo tren colisionarían.
function namespaceSvgIds(svg: string, suffix: string): string {
  const ids = new Set<string>();
  const idMatches = svg.matchAll(/\sid="([^"]+)"/g);
  for (const m of idMatches) ids.add(m[1]);

  let result = svg;
  for (const id of ids) {
    const unique = `${id}-${suffix}`;
    result = result
      .replaceAll(`id="${id}"`, `id="${unique}"`)
      .replaceAll(`url(#${id})`, `url(#${unique})`)
      .replaceAll(`href="#${id}"`, `href="#${unique}"`)
      .replaceAll(`xlink:href="#${id}"`, `xlink:href="#${unique}"`);
  }
  return result;
}

const cartas = await Promise.all(
  trenes.map(async (tren) => {
    const propia = findAsset(
      imagenesModules,
      new RegExp(`/${tren.slug}\\.(jpe?g|png)$`, "i"),
    );
    const fuente = propia ?? defaultImage;
    const imagen = fuente
      ? await getImage({ src: fuente, width: 560, format: "webp", quality: 78 })
      : null;

    const marcoLimpio = marcoUniversal ? stripRootSvgSize(marcoUniversal) : "";

    const imagenSrc = imagen?.src ?? "";

    return {
      ...tren,
      numeroTexto: String(tren.numero).padStart(2, "0"),
      imagenSrc,
      acuarelaSrc: resolverAcuarela(tren.slug, imagenSrc),
      colorCategoria: hexToRgba(COLOR_CATEGORIA[tren.categoria_slug] ?? "#6b4e8e", OPACIDAD_BANDA),
      // un namespace de IDs distinto para cada instancia (miniatura / ampliada)
      marcoMini: marcoLimpio ? namespaceSvgIds(marcoLimpio, `${tren.slug}-mini`) : "",
      marcoGrande: marcoLimpio ? namespaceSvgIds(marcoLimpio, `${tren.slug}-grande`) : "",
      masaTexto: tren.masa_texto ?? "—",
      ecologicoTexto: `${tren.ecologico}/10`,
      historicoTexto: `${tren.historico}/10`,
    };
  }),
);

const categorias = cartas.reduce<
  { categoria: string; categoria_slug: string; cartas: typeof cartas }[]
>((acc, carta) => {
  let grupo = acc.find((g) => g.categoria_slug === carta.categoria_slug);
  if (!grupo) {
    grupo = { categoria: carta.categoria, categoria_slug: carta.categoria_slug, cartas: [] };
    acc.push(grupo);
  }
  grupo.cartas.push(carta);
  return acc;
}, []);
---

<BaseLayout
  title="Cartas de trenes — vista previa | ccordoba.es"
  description="Galería de cartas coleccionables de trenes de Renfe. Vista previa privada, aún sin publicar."
  noindex
>
  <script is:inline>
    (function () {
      // Selector Foto/Acuarela oculto temporalmente (ver .modo-toggle más
      // abajo): se fuerza acuarela siempre, ignorando lo guardado en
      // localStorage. Para reactivar el selector, restaura el bloque de
      // abajo (comentado) y quita el classList.add fijo.
      //
      // try {
      //   if (localStorage.getItem("modo-visualizacion-trenes") === "acuarela") {
      //     document.body.classList.add("modo-acuarela");
      //   }
      // } catch (e) {}
      document.body.classList.add("modo-acuarela");
    })();
  </script>

  <div class="cartas-fondo">
    <section class="border-t border-linea px-8 py-14">
      <div class="mx-auto max-w-[1040px]">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="mb-1.5 font-mono text-[13px] uppercase tracking-[0.08em] text-senal">
            Vista previa privada
          </p>
          <h1 class="font-display text-[28px] font-semibold">Cartas de trenes</h1>
        </div>

        <div class="modo-toggle" role="group" aria-label="Modo de visualización">
          <button type="button" class="modo-btn" data-modo="foto">Foto</button>
          <button type="button" class="modo-btn" data-modo="acuarela">Acuarela</button>
        </div>
      </div>

      {
        categorias.map((grupo) => (
          <div class="mb-16 last:mb-0">
            <h2 class="mb-5 font-display text-lg font-semibold text-ink">
              {grupo.categoria}
            </h2>
            <ul class="cartas-grid">
              {grupo.cartas.map((carta) => (
                <li>
                  <TrainCardThumbnail
                    slug={carta.slug}
                    categoria={carta.categoria}
                    numeroTexto={carta.numeroTexto}
                    nombre={carta.nombre}
                    fabricante={carta.fabricante}
                    imagenSrc={carta.imagenSrc}
                    acuarelaSrc={carta.acuarelaSrc}
                    marco={carta.marcoMini}
                    colorCategoria={carta.colorCategoria}
                    nuevo={carta.nuevo}
                  />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      </div>
    </section>
  </div>

  <div id="carta-overlay" class="carta-overlay"></div>
  <button
    type="button"
    id="carta-nav-prev"
    class="carta-nav carta-nav-prev"
    aria-label="Carta anterior"
  >
    ‹
  </button>
  <button
    type="button"
    id="carta-nav-next"
    class="carta-nav carta-nav-next"
    aria-label="Carta siguiente"
  >
    ›
  </button>

  {
    cartas.map((carta) => (
      <TrainCardExpanded
        slug={carta.slug}
        categoria={carta.categoria}
        numeroTexto={carta.numeroTexto}
        nombre={carta.nombre}
        fabricante={carta.fabricante}
        imagenSrc={carta.imagenSrc}
        acuarelaSrc={carta.acuarelaSrc}
        marco={carta.marcoGrande}
        colorCategoria={carta.colorCategoria}
        velocidad_texto={carta.velocidad_texto}
        potencia_texto={carta.potencia_texto}
        masaTexto={carta.masaTexto}
        unidades_construidas={carta.unidades_construidas}
        ecologicoTexto={carta.ecologicoTexto}
        historicoTexto={carta.historicoTexto}
        hito={carta.hito}
        nuevo={carta.nuevo}
      />
    ))
  }
</BaseLayout>

<style is:global>
  @font-face {
    font-family: "Sora";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/sora-400.woff2") format("woff2");
  }
  @font-face {
    font-family: "Sora";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/fonts/sora-500.woff2") format("woff2");
  }
  @font-face {
    font-family: "Sora";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("/fonts/sora-700.woff2") format("woff2");
  }
  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/fonts/jetbrains-mono-400.woff2") format("woff2");
  }
</style>

<style>
  /*
    Fondo "acuarela" muy sutil detrás de la rejilla: color base Papel +
    3 manchas radiales tenues (4-7% opacidad) en los colores de marca
    (Señal, Andén, Vía). background-attachment:fixed para que las manchas
    no se desplacen con el scroll. Solo detrás de la sección de la
    galería (no en el overlay/carta ampliada, que ya son opacos), y con
    opacidades bajas a propósito para que las cartas sigan siendo las
    protagonistas visuales.
  */
  .cartas-fondo {
    background-color: #faf9f7;
    background-image:
      radial-gradient(circle 60vmin at 8% 6%, rgba(107, 78, 142, 0.06) 0%, transparent 68%),
      radial-gradient(circle 60vmin at 93% 92%, rgba(159, 201, 196, 0.06) 0%, transparent 68%),
      radial-gradient(circle 32vmin at 50% 4%, rgba(228, 220, 239, 0.07) 0%, transparent 65%);
    background-repeat: no-repeat;
    background-attachment: fixed;
  }

  .modo-toggle {
    /* Selector Foto/Acuarela oculto temporalmente: solo visual, la lógica
       de src/pages/cartas-trenes.astro (setupModoVisualizacion) sigue
       intacta. Para reactivarlo, quita este display:none. */
    display: none;
    flex-shrink: 0;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: #f2f0ec;
    border: 1px solid #e7e4de;
  }
  .modo-btn {
    border-radius: 999px;
    padding: 7px 16px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: #6b6e76;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .modo-btn:hover {
    color: #23262b;
  }
  .modo-btn.is-active {
    background: #6b4e8e;
    color: #fff;
  }

  .cartas-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (min-width: 480px) {
    .cartas-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 720px) {
    .cartas-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    .cartas-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
    }
  }

  .carta-overlay {
    position: fixed;
    inset: 0;
    background: rgba(8, 7, 10, 0.75);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
    z-index: 900;
  }
  .carta-overlay.is-visible {
    pointer-events: auto;
  }

  .carta-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    left: 12px;
    right: auto;
    z-index: 1010;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 999px;
    background: rgba(12, 12, 16, 0.55);
    color: #fff;
    font-family: "Sora", sans-serif;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      background-color 150ms ease;
  }
  .carta-nav:hover {
    background: rgba(12, 12, 16, 0.8);
  }
  .carta-nav-next {
    left: auto;
    right: 12px;
  }
  .carta-nav.is-visible {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
  }
  .carta-nav.is-disabled {
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .carta-nav {
      width: 48px;
      height: 48px;
      font-size: 24px;
    }
    .carta-nav-prev {
      left: 24px;
    }
    .carta-nav-next {
      right: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta-overlay,
    .carta-nav {
      transition: none;
    }
  }
</style>

<script>
  function setupCartas() {
    const overlayEl = document.getElementById("carta-overlay");
    const navPrevEl = document.getElementById("carta-nav-prev");
    const navNextEl = document.getElementById("carta-nav-next");
    const thumbnails = document.querySelectorAll<HTMLElement>(".carta-mini");
    if (!overlayEl || !(navPrevEl instanceof HTMLButtonElement) || !(navNextEl instanceof HTMLButtonElement)) {
      return;
    }
    const overlay = overlayEl;
    const navPrev = navPrevEl;
    const navNext = navNextEl;

    // Orden "de rejilla": se lee directamente del DOM ya renderizado (agrupado
    // por categoría) en vez de recalcularlo, para que anterior/siguiente
    // coincida exactamente con el orden visual, no con el orden crudo de
    // trenes.json.
    const ordenSlugs = Array.from(thumbnails)
      .map((el) => el.dataset.slug)
      .filter((slug): slug is string => Boolean(slug));

    let activeExpanded: HTMLElement | null = null;
    let activeThumb: HTMLElement | null = null;
    let indiceActual = -1;
    let enTransicion = false;

    function findExpanded(slug: string): HTMLElement | null {
      return document.querySelector<HTMLElement>(`.carta-grande[data-slug="${slug}"]`);
    }

    function actualizarBotonesNav() {
      const visible = activeExpanded !== null;
      navPrev.classList.toggle("is-visible", visible);
      navNext.classList.toggle("is-visible", visible);
      if (!visible) return;
      const esPrimero = indiceActual <= 0;
      const esUltimo = indiceActual >= ordenSlugs.length - 1;
      navPrev.classList.toggle("is-disabled", esPrimero);
      navPrev.disabled = esPrimero;
      navNext.classList.toggle("is-disabled", esUltimo);
      navNext.disabled = esUltimo;
    }

    function openCard(thumb: HTMLElement) {
      if (activeExpanded) return;
      const slug = thumb.dataset.slug;
      if (!slug) return;
      const expanded = findExpanded(slug);
      if (!expanded) return;

      const firstRect = thumb.getBoundingClientRect();
      expanded.classList.add("is-active");
      const lastRect = expanded.getBoundingClientRect();

      const dx =
        firstRect.left + firstRect.width / 2 - (lastRect.left + lastRect.width / 2);
      const dy =
        firstRect.top + firstRect.height / 2 - (lastRect.top + lastRect.height / 2);
      const scale = firstRect.width / lastRect.width;

      expanded.style.transition = "none";
      expanded.style.transform = `translate(-50%, -50%) translate(${dx}px, ${dy}px) scale(${scale}) rotate(-6deg)`;

      // Forzar reflow para que el navegador registre el estado inicial
      // antes de animar al estado final.
      void expanded.offsetWidth;

      overlay.classList.add("is-visible");

      requestAnimationFrame(() => {
        overlay.style.opacity = "1";
        expanded.style.transition = "transform 420ms cubic-bezier(.2,.85,.25,1)";
        expanded.style.transform = "translate(-50%, -50%) scale(1) rotate(0deg)";
      });

      thumb.style.opacity = "0";
      document.body.style.overflow = "hidden";

      activeExpanded = expanded;
      activeThumb = thumb;
      indiceActual = ordenSlugs.indexOf(slug);
      actualizarBotonesNav();
    }

    function closeExpanded() {
      if (!activeExpanded || !activeThumb) return;
      const expanded = activeExpanded;
      const thumb = activeThumb;

      const firstRect = thumb.getBoundingClientRect();
      const lastRect = expanded.getBoundingClientRect();
      const dx =
        firstRect.left + firstRect.width / 2 - (lastRect.left + lastRect.width / 2);
      const dy =
        firstRect.top + firstRect.height / 2 - (lastRect.top + lastRect.height / 2);
      const scale = firstRect.width / lastRect.width;

      overlay.style.opacity = "0";
      expanded.style.transition = "transform 360ms cubic-bezier(.4,0,.2,1)";
      expanded.style.transform = `translate(-50%, -50%) translate(${dx}px, ${dy}px) scale(${scale}) rotate(-4deg)`;

      const onEnd = () => {
        expanded.removeEventListener("transitionend", onEnd);
        expanded.classList.remove("is-active");
        thumb.style.opacity = "";
        overlay.classList.remove("is-visible");
        document.body.style.overflow = "";
      };
      expanded.addEventListener("transitionend", onEnd, { once: true });

      activeExpanded = null;
      activeThumb = null;
      indiceActual = -1;
      actualizarBotonesNav();
    }

    // Navega a la carta anterior/siguiente (según el orden de la rejilla)
    // sin cerrar el modal: desactiva la carta ampliada actual y activa la de
    // al lado con un fundido + deslizamiento lateral corto, en vez de
    // reutilizar la animación de apertura (que parte de la posición de una
    // miniatura concreta, y no tendría sentido con el modal ya centrado).
    function navegar(direccion: 1 | -1) {
      if (enTransicion || !activeExpanded || indiceActual === -1) return;
      const nuevoIndice = indiceActual + direccion;
      if (nuevoIndice < 0 || nuevoIndice >= ordenSlugs.length) return;

      const nuevoSlug = ordenSlugs[nuevoIndice];
      const nuevaTarjeta = findExpanded(nuevoSlug);
      const nuevaMiniatura = document.querySelector<HTMLElement>(
        `.carta-mini[data-slug="${nuevoSlug}"]`,
      );
      if (!nuevaTarjeta || !nuevaMiniatura) return;

      enTransicion = true;
      const tarjetaAnterior = activeExpanded;
      const desplazamiento = direccion === 1 ? -32 : 32;

      tarjetaAnterior.style.transition = "transform 220ms ease, opacity 220ms ease";
      tarjetaAnterior.style.transform = `translate(-50%, -50%) translateX(${desplazamiento}px)`;
      tarjetaAnterior.style.opacity = "0";

      const onSalidaFin = () => {
        tarjetaAnterior.removeEventListener("transitionend", onSalidaFin);
        tarjetaAnterior.classList.remove("is-active");
        tarjetaAnterior.style.transition = "";
        tarjetaAnterior.style.transform = "";
        tarjetaAnterior.style.opacity = "";
      };
      tarjetaAnterior.addEventListener("transitionend", onSalidaFin, { once: true });

      nuevaTarjeta.style.zIndex = "1001";
      nuevaTarjeta.style.transition = "none";
      nuevaTarjeta.style.transform = `translate(-50%, -50%) translateX(${-desplazamiento}px)`;
      nuevaTarjeta.style.opacity = "0";
      nuevaTarjeta.classList.add("is-active");

      // Forzar reflow para que el navegador registre el estado inicial
      // antes de animar al estado final.
      void nuevaTarjeta.offsetWidth;

      requestAnimationFrame(() => {
        nuevaTarjeta.style.transition = "transform 220ms ease, opacity 220ms ease";
        nuevaTarjeta.style.transform = "translate(-50%, -50%)";
        nuevaTarjeta.style.opacity = "1";
      });

      const onEntradaFin = () => {
        nuevaTarjeta.removeEventListener("transitionend", onEntradaFin);
        nuevaTarjeta.style.transition = "";
        nuevaTarjeta.style.transform = "";
        nuevaTarjeta.style.opacity = "";
        nuevaTarjeta.style.zIndex = "";
        enTransicion = false;
      };
      nuevaTarjeta.addEventListener("transitionend", onEntradaFin, { once: true });

      activeExpanded = nuevaTarjeta;
      activeThumb = nuevaMiniatura;
      indiceActual = nuevoIndice;
      actualizarBotonesNav();
    }

    thumbnails.forEach((thumb) => {
      thumb.addEventListener("click", () => openCard(thumb));
      thumb.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openCard(thumb);
        }
      });
    });

    document.querySelectorAll<HTMLElement>(".carta-grande").forEach((expanded) => {
      expanded.addEventListener("click", (e) => e.stopPropagation());

      let touchStartX = 0;
      let touchStartY = 0;
      expanded.addEventListener(
        "touchstart",
        (e) => {
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
        },
        { passive: true },
      );
      expanded.addEventListener(
        "touchend",
        (e) => {
          const touch = e.changedTouches[0];
          const dx = touch.clientX - touchStartX;
          const dy = touch.clientY - touchStartY;
          const UMBRAL_SWIPE = 50;
          if (Math.abs(dx) > UMBRAL_SWIPE && Math.abs(dx) > Math.abs(dy) * 1.5) {
            navegar(dx < 0 ? 1 : -1);
          }
        },
        { passive: true },
      );
    });

    overlay.addEventListener("click", closeExpanded);
    navPrev.addEventListener("click", () => navegar(-1));
    navNext.addEventListener("click", () => navegar(1));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeExpanded();
    });
    document.addEventListener("keydown", (e) => {
      if (!activeExpanded) return;
      if (e.key === "ArrowLeft") navegar(-1);
      if (e.key === "ArrowRight") navegar(1);
    });
  }

  setupCartas();
  document.addEventListener("astro:page-load", setupCartas);

  function setupModoVisualizacion() {
    const botones = document.querySelectorAll<HTMLButtonElement>(".modo-btn");
    if (botones.length === 0) return;

    function modoActual(): "foto" | "acuarela" {
      return document.body.classList.contains("modo-acuarela") ? "acuarela" : "foto";
    }

    function actualizarBotones() {
      const activo = modoActual();
      botones.forEach((boton) => {
        boton.classList.toggle("is-active", boton.dataset.modo === activo);
      });
    }

    actualizarBotones();

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const modo = boton.dataset.modo === "acuarela" ? "acuarela" : "foto";
        document.body.classList.toggle("modo-acuarela", modo === "acuarela");
        try {
          localStorage.setItem("modo-visualizacion-trenes", modo);
        } catch (e) {
          // localStorage puede no estar disponible (modo privado, etc.):
          // el interruptor sigue funcionando, solo no se recuerda la próxima visita.
        }
        actualizarBotones();
      });
    });
  }

  setupModoVisualizacion();
  document.addEventListener("astro:page-load", setupModoVisualizacion);
</script>
