---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import { getCollection } from "astro:content";

const proyectos = await getCollection("proyectos");

const candidatosDestacado = proyectos.filter((p) => p.data.destacado);
if (candidatosDestacado.length > 1) {
  throw new Error(
    `Solo puede haber un proyecto con destacado:true. Encontrados: ${candidatosDestacado
      .map((p) => p.id)
      .join(", ")}`,
  );
}
const destacado = candidatosDestacado[0];

const enHome = proyectos
  .filter((p) => p.data.en_home && p.id !== destacado?.id)
  .sort((a, b) => {
    if (a.data.nuevo !== b.data.nuevo) return a.data.nuevo ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  })
  .slice(0, 4);
---

<BaseLayout>
  <header class="relative overflow-hidden px-8 pb-16 pt-10">
    <div class="mx-auto grid max-w-[1040px] items-center gap-16 lg:grid-cols-[1fr_420px]">
      <div>
        <div class="mb-[22px] flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.08em] text-senal">
          <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-senal"></span>
          ccordoba.es — laboratorio personal
        </div>
        <h1 class="max-w-[780px] font-display text-[38px] font-semibold leading-[1.05] tracking-[-0.015em] sm:text-[52px] lg:text-[64px]">
          Este es mi <span class="text-senal">laboratorio</span>.
        </h1>
        <p class="mt-[26px] max-w-[560px] text-lg leading-relaxed text-[#4B4E56]">
          Soy Carlos Córdoba Camacho, apasionado de la tecnología y la
          transformación digital. Aquí voy probando, rompiendo y aprendiendo
          cosas por mi cuenta, relacionadas con movilidad y tecnología, casi
          siempre con ayuda de IA.
        </p>
        <div class="mt-10 flex flex-wrap gap-3.5">
          <a
            href="#laboratorio"
            class="inline-flex items-center gap-2 rounded-[3px] bg-senal px-[22px] py-[13px] font-mono text-[13px] text-white transition-transform hover:-translate-y-px"
          >
            Ver proyectos ↓
          </a>
          <a
            href="/sobre-mi"
            class="inline-flex items-center gap-2 rounded-[3px] border border-linea px-[22px] py-[13px] font-mono text-[13px] text-ink transition-transform hover:-translate-y-px"
          >
            Sobre mí
          </a>
          <a
            href="https://linkedin.com/in/carloscordobacamacho"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-[3px] border border-linea px-[22px] py-[13px] font-mono text-[13px] text-ink transition-transform hover:-translate-y-px"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>

      <div class="relative hidden aspect-square w-full max-w-[420px] items-center justify-center lg:flex" aria-hidden="true">
        <div class="absolute h-full w-full rounded-full bg-via/60 blur-2xl"></div>
        <div class="absolute inset-4 rounded-full border border-dashed border-senal/35"></div>
        <div class="absolute inset-[52px] rounded-full border border-linea"></div>

        <span class="absolute left-1 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-anden"></span>
        <span class="absolute right-8 top-7 h-2 w-2 rounded-full bg-senal/70"></span>
        <span class="absolute bottom-12 right-2 h-2.5 w-2.5 animate-pulse-dot rounded-full bg-senal"></span>
        <span class="absolute bottom-4 left-20 h-1.5 w-1.5 rounded-full bg-anden/80"></span>

        <svg
          viewBox="0 0 24 24"
          width="240"
          height="240"
          fill="none"
          class="relative text-senal drop-shadow-md"
        >
          <path
            d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"
            stroke="currentColor"
            stroke-width="0.15"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M6.453 15h11.094"
            stroke="currentColor"
            stroke-width="0.15"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M8.5 2h7"
            stroke="currentColor"
            stroke-width="0.15"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <circle class="lab-bubble lab-bubble-1" cx="10" cy="19.2" r="0.7" fill="currentColor" />
          <circle class="lab-bubble lab-bubble-2 text-anden" cx="13.6" cy="20.1" r="0.5" fill="currentColor" />
          <circle class="lab-bubble lab-bubble-3" cx="11.4" cy="17.2" r="0.55" fill="currentColor" />
          <circle class="lab-bubble lab-bubble-4 text-anden" cx="14.6" cy="18.6" r="0.45" fill="currentColor" />
          <circle class="lab-bubble lab-bubble-5" cx="9.4" cy="20.6" r="0.5" fill="currentColor" />
        </svg>
      </div>
    </div>
  </header>

  {
    destacado && (
      <FeaturedProject
        title={destacado.data.title}
        description={destacado.data.description}
        categorias={destacado.data.categorias}
        link={destacado.data.link}
        liveUrl={destacado.data.live_url ?? destacado.data.link}
        video={destacado.data.video}
        imagen={destacado.data.portada?.imagen}
        imagenAlt={destacado.data.portada?.alt}
      />
    )
  }

  <section id="laboratorio" class="border-t border-linea px-8 py-14">
    <div class="mx-auto max-w-[1040px]">
      <div class="mb-11">
        <h2 class="font-display text-[28px] font-semibold">El laboratorio</h2>
      </div>
      <p class="mb-12 text-base leading-relaxed text-[#4B4E56]">
        Aquí va quedando lo que voy montando con datos abiertos de transporte
        y ayuda de IA. Algunas cosas están pulidas, otras son pruebas a medio
        hacer — lo dejo tal cual, porque el proceso también cuenta. Esto
        crece sin calendario fijo, según voy teniendo tiempo y ganas.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          enHome.map((proyecto) => (
            <ProjectCard
              title={proyecto.data.title}
              description={proyecto.data.description}
              categorias={proyecto.data.categorias}
              images={proyecto.data.images}
              video={proyecto.data.video}
              link={proyecto.data.link}
              nuevo={proyecto.data.nuevo}
            />
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a
          href="/proyectos"
          class="group inline-flex items-center gap-2 rounded-[3px] border border-linea px-[22px] py-[13px] font-mono text-[13px] text-ink transition-transform hover:-translate-y-px"
        >
          Ver todos los proyectos
          <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lab-bubble {
    transform-box: fill-box;
    transform-origin: center;
    animation: lab-bubble-rise 2.6s ease-in infinite;
  }
  .lab-bubble-1 {
    animation-delay: 0s;
  }
  .lab-bubble-2 {
    animation-delay: 0.5s;
    animation-duration: 3.1s;
  }
  .lab-bubble-3 {
    animation-delay: 1s;
    animation-duration: 2.3s;
  }
  .lab-bubble-4 {
    animation-delay: 1.6s;
    animation-duration: 2.9s;
  }
  .lab-bubble-5 {
    animation-delay: 0.3s;
    animation-duration: 2.5s;
  }

  @keyframes lab-bubble-rise {
    0% {
      transform: translateY(0%) scale(1);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    70% {
      opacity: 0.55;
    }
    100% {
      transform: translateY(-260%) scale(0.85);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-bubble {
      animation: none;
      opacity: 0.7;
    }
  }
</style>
